# =============================================================================
#  wzbp · 王者荣耀 BP 展示台 —— 运行时环境变量（完整版模板）
# =============================================================================
#
#  用法：
#    1) 复制成 .env            cp .env.example .env
#    2) 只改 WZBP_DB_PASSWORD  这一项（改成你数据库用户的真实密码）
#    3) 重启服务
#
#  ⚠️ .env 里含数据库密码，已在 .gitignore 里 → 不要提交到 git。
#
#  手动试跑（排错时很有用）：
#    cd /www/wwwroot/wzbp
#    set -a && . ./.env && set +a
#    node server/index.js
#
#  说明：服务**只监听 127.0.0.1**（写死的，没有开关），
#        外网访问一律走 Nginx 反代 /api/ 与 /api/stream（教程 §7）。
# =============================================================================


# -----------------------------------------------------------------------------
#  必填项（只有这一项真的需要你填）
# -----------------------------------------------------------------------------
# 数据库密码。必须和 MySQL 里 WZBP_DB_USER 那个用户的真实密码一致。
# 改了这里但没改数据库密码 → 服务连不上，/api/health 会返回 db:false。
#
# ⚠️ 记得把 CHANGE_ME 换掉！留着它服务会连不上数据库。
WZBP_DB_PASSWORD="CHANGE_ME"


# -----------------------------------------------------------------------------
#  数据库连接
# -----------------------------------------------------------------------------
# 库名。允许字母数字下划线，最长 64。表结构由服务首次启动时自动创建。
WZBP_DB_NAME="wzbp"

# 数据库用户名。装的时候通常就叫 wzbp（不要用 root 跑应用）。
WZBP_DB_USER="wzbp"

# 数据库地址与端口。宝塔默认 3306；有的环境是 3307，用 ss -lntp | grep mysql 确认。
WZBP_DB_HOST="127.0.0.1"
WZBP_DB_PORT=3306

# 连接池大小（1..50）。1 核 1G 的小机器保持 10 就够；人多可调到 20。
# WZBP_DB_POOL=10

# 连接超时毫秒（1000..60000）。数据库在别的机器上、网络慢时调大。
# WZBP_DB_CONNECT_TIMEOUT=10000


# -----------------------------------------------------------------------------
#  服务端口
# -----------------------------------------------------------------------------
# Node 服务监听端口（1..65535）。只监听 127.0.0.1，不对公网开放。
# 改了这里，Nginx 反代里的 proxy_pass 也要跟着改（教程 §7.2）。
WZBP_PORT=8787


# -----------------------------------------------------------------------------
#  仅自检用，生产环境不要开
# -----------------------------------------------------------------------------
# memory = 内存驱动，不连真实 MySQL，重启数据就没了。
# 只在「没有数据库的机器上跑自检脚本」时用：WZBP_DB_DRIVER=memory
# WZBP_DB_DRIVER=mysql
